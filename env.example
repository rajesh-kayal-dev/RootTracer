# RootTracer v2 — LOCAL DEVELOPMENT ONLY
# Copy to .env (gitignored). Use distinct unique values for every CHANGE_ME value.
# Never commit real credentials. Process-specific config schemas should validate the keys they use.
# Compose container DNS: postgres, redis, rabbitmq, mailpit, identity-service, etc.
# When running an app ON YOUR HOST rather than in Compose, use localhost-facing URLs instead.

# ── Shared runtime / environment ─────────────────────────────────────────────
NODE_ENV=development
APP_ENV=local
LOG_LEVEL=debug
LOG_FORMAT=json
SERVICE_REQUEST_TIMEOUT_MS=5000
# Allow HTTP locally only; enforce HTTPS and secure cookies behind production ingress.
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:4000
PUBLIC_INGEST_URL=http://localhost:4002

# ── Frontend: apps/web (public variables are readable by browsers) ────────────
NEXT_PUBLIC_APP_NAME=RootTracer
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_POLL_INTERVAL_MS=15000
NEXT_PUBLIC_ENABLE_RECOVERY=false
# NEVER place API keys, passwords, Gemini keys, or session secrets in NEXT_PUBLIC_*

# ── Internal service binding ports (illustrative defaults) ───────────────────
WEB_PORT=3000
GATEWAY_PORT=4000
IDENTITY_PORT=4001
INGESTION_PORT=4002
INCIDENT_PORT=4003
AI_PORT=4004
NOTIFICATION_HEALTH_PORT=4005

# ── Gateway / browser session policy ─────────────────────────────────────────
# Same-site local setup should proxy /api/v1 through the Next.js app origin to
# avoid credentialed cross-origin cookie complexity. If using cross-origin local
# ports, configure CORS/CSRF deliberately; do not enable wildcard credential CORS.
GATEWAY_PUBLIC_ORIGIN=http://localhost:3000
SESSION_COOKIE_NAME=roottracer.sid
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=604800
CSRF_COOKIE_NAME=roottracer.csrf
CSRF_HEADER_NAME=x-csrf-token
# Local example only; replace with random 32+ bytes before use.
CSRF_SECRET=CHANGE_ME_local_random_csrf_secret_32_chars
# Internal service authentication; DO NOT expose to SDK or browser.
INTERNAL_SERVICE_TOKEN=CHANGE_ME_local_random_internal_service_token_32_chars

# ── Private service discovery (inside Docker Compose network) ────────────────
IDENTITY_SERVICE_URL=http://identity-service:4001
INGESTION_SERVICE_URL=http://ingestion-service:4002
INCIDENT_SERVICE_URL=http://incident-service:4003
AI_SERVICE_URL=http://ai-service:4004
# Worker does not require a public notification API.
NOTIFICATION_HEALTH_URL=http://notification-service:4005/healthz

# ── Postgres server/bootstrap (infra-only; never inject admin creds into apps) ─
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=roottracer
POSTGRES_ADMIN_USER=roottracer_admin
POSTGRES_ADMIN_PASSWORD=CHANGE_ME_local_postgres_admin_password
# Dedicated schema/role per owning service, same local PostgreSQL database.
# SQL bootstrap must create each role, schema and least-privilege grants.
IDENTITY_DATABASE_URL=postgresql://identity_user:CHANGE_ME_identity_db_password@postgres:5432/roottracer?options=-csearch_path%3Didentity
INCIDENT_DATABASE_URL=postgresql://incident_user:CHANGE_ME_incident_db_password@postgres:5432/roottracer?options=-csearch_path%3Dincident
AI_DATABASE_URL=postgresql://ai_user:CHANGE_ME_ai_db_password@postgres:5432/roottracer?options=-csearch_path%3Dai
NOTIFICATION_DATABASE_URL=postgresql://notification_user:CHANGE_ME_notification_db_password@postgres:5432/roottracer?options=-csearch_path%3Dnotification
PG_POOL_MAX=10
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=10000
PG_SSL_MODE=disable

# ── Redis sessions, ingestion rate limits and verified-key caches ─────────────
REDIS_URL=redis://redis:6379/0
REDIS_KEY_PREFIX=roottracer:local:
INGEST_API_KEY_CACHE_TTL_SECONDS=30
INGEST_RATE_LIMIT_EVENTS_PER_MINUTE=6000
INGEST_MAX_BATCH_EVENTS=100
INGEST_MAX_BODY_BYTES=262144

# ── RabbitMQ credentials, exchanges, queue topology ──────────────────────────
RABBITMQ_DEFAULT_USER=roottracer
RABBITMQ_DEFAULT_PASS=CHANGE_ME_local_rabbitmq_password
RABBITMQ_DEFAULT_VHOST=roottracer_local
RABBITMQ_URL=amqp://roottracer:CHANGE_ME_local_rabbitmq_password@rabbitmq:5672/roottracer_local
RABBITMQ_PREFETCH=25
RABBITMQ_PUBLISH_CONFIRM_TIMEOUT_MS=5000
RABBITMQ_PUBLISH_MANDATORY=true
TELEMETRY_EXCHANGE=roottracer.telemetry.v1
TELEMETRY_ROUTING_KEY=error.ingested
TELEMETRY_QUEUE=telemetry.events
TELEMETRY_RETRY_QUEUE=telemetry.events.retry
TELEMETRY_DLQ=telemetry.events.dlq
TELEMETRY_MAX_DELIVERIES=5
AI_EXCHANGE=roottracer.ai.v1
AI_ROUTING_KEY=rca.requested
AI_QUEUE=ai.investigations
AI_RETRY_QUEUE=ai.investigations.retry
AI_DLQ=ai.investigations.dlq
AI_MAX_DELIVERIES=4
NOTIFICATION_EXCHANGE=roottracer.notifications.v1
NOTIFICATION_ROUTING_KEY=notifications.email
NOTIFICATION_QUEUE=notifications.email
NOTIFICATION_RETRY_QUEUE=notifications.email.retry
NOTIFICATION_DLQ=notifications.email.dlq
NOTIFICATION_MAX_DELIVERIES=5
# Recovery queues intentionally OMITTED: future phase, not MVP.

# ── Incident storage / partition maintenance ─────────────────────────────────
EVENT_RETENTION_DAYS=30
EVENT_PARTITION_CREATE_DAYS_AHEAD=7
EVENT_RECEIPT_RETENTION_DAYS=45
INCIDENT_DEFAULT_ENVIRONMENT=production
SDK_EVENT_SCHEMA_VERSION=1
INCIDENT_SEARCH_PAGE_SIZE=25

# ── Gemini AI investigation (on-demand; bounded requests) ────────────────────
AI_PROVIDER=gemini
GEMINI_API_KEY=CHANGE_ME_or_leave_unset_when_AI_MOCK_MODE_true
GEMINI_MODEL=CHANGE_ME_confirm_current_supported_gemini_model
AI_MOCK_MODE=true
AI_PROMPT_VERSION=rca-v1
AI_REQUEST_TIMEOUT_MS=20000
AI_MAX_CONCURRENT_JOBS=2
AI_MAX_REQUESTS_PER_PROJECT_PER_DAY=20
AI_MAX_RETRIES=3

# ── Email (Mailpit for local, Resend for hosted environments) ─────────────────
EMAIL_PROVIDER=mailpit
EMAIL_FROM=RootTracer <alerts@example.test>
MAILPIT_SMTP_HOST=mailpit
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_URL=http://localhost:8025
RESEND_API_KEY=
EMAIL_ALERT_COOLDOWN_SECONDS=900
EMAIL_MAX_SEND_RETRIES=3

# ── SDK test app / integration tests only (not a backend service secret) ───────
# Create a real project key through onboarding; keep it out of source control.
ROOTTRACER_API_KEY=CHANGE_ME_project_ingest_key_generated_at_runtime
ROOTTRACER_ENDPOINT=http://localhost:4002/ingest/v1
ROOTTRACER_ENVIRONMENT=development
ROOTTRACER_RELEASE=local-dev
ROOTTRACER_SAMPLE_RATE=1.0
ROOTTRACER_TIMEOUT_MS=3000

# ── Operational / local test controls ─────────────────────────────────────────
HEALTH_CHECK_TIMEOUT_MS=3000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=10000
ENABLE_SWAGGER=true
ENABLE_TEST_ROUTES=false
# Security defaults: never enable recoveries automatically in MVP.
ENABLE_RECOVERY_WORKERS=false
ENABLE_GITHUB_INTEGRATION=false
ENABLE_BUSINESS_IMPACT=false

# ── Production notes (not runtime variables) ─────────────────────────────────
# Production: use secret manager, TLS to Postgres/Redis/RabbitMQ/REST,
# domain-specific HTTPS ingress, secure HttpOnly session cookies,
# unique per-service DB/broker credentials, verified Resend domain,
# restricted internal service auth, no Mailpit exposure, and provider usage limits.
