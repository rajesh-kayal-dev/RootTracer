{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RootTracer Event Contracts v1",
  "$defs": {
    "error.ingested": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.roottracer.dev/events/v1/error.ingested.schema.json",
      "title": "RootTracer error.ingested v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_type",
        "schema_version",
        "created_at",
        "correlation_id",
        "attempt",
        "payload"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_type": {
          "type": "string",
          "const": "error.ingested"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "request_id",
            "batch_id",
            "accepted_at",
            "events"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "request_id": {
              "type": "string",
              "format": "uuid"
            },
            "batch_id": {
              "type": "string",
              "format": "uuid"
            },
            "accepted_at": {
              "type": "string",
              "format": "date-time"
            },
            "events": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "event_id",
                  "occurred_at",
                  "type",
                  "message",
                  "severity",
                  "environment",
                  "context",
                  "sdk_version",
                  "schema_version"
                ],
                "properties": {
                  "event_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "occurred_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "type": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 4096
                  },
                  "stack_trace": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 32768
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "INFO",
                      "WARNING",
                      "ERROR",
                      "CRITICAL"
                    ]
                  },
                  "environment": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "release": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "maxLength": 128
                  },
                  "context": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [],
                    "properties": {
                      "http_method": {
                        "type": "string",
                        "enum": [
                          "GET",
                          "POST",
                          "PUT",
                          "PATCH",
                          "DELETE",
                          "HEAD",
                          "OPTIONS"
                        ]
                      },
                      "route": {
                        "type": "string",
                        "maxLength": 250
                      },
                      "request_id": {
                        "type": "string",
                        "maxLength": 128
                      },
                      "tags": {
                        "type": "object",
                        "maxProperties": 20,
                        "additionalProperties": {
                          "type": "string",
                          "maxLength": 120
                        }
                      }
                    }
                  },
                  "sdk_version": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "schema_version": {
                    "type": "integer",
                    "const": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "rca.requested": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.roottracer.dev/events/v1/rca.requested.schema.json",
      "title": "RootTracer rca.requested v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_type",
        "schema_version",
        "created_at",
        "correlation_id",
        "attempt",
        "payload"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_type": {
          "type": "string",
          "const": "rca.requested"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "incident_id",
            "investigation_id",
            "requested_by",
            "evidence_hash",
            "prompt_version"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "incident_id": {
              "type": "string",
              "format": "uuid"
            },
            "investigation_id": {
              "type": "string",
              "format": "uuid"
            },
            "requested_by": {
              "type": "string",
              "format": "uuid"
            },
            "evidence_hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "prompt_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        }
      }
    },
    "recovery.approved": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.roottracer.dev/events/v1/recovery.approved.schema.json",
      "title": "RootTracer recovery.approved v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_type",
        "schema_version",
        "created_at",
        "correlation_id",
        "attempt",
        "payload"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_type": {
          "type": "string",
          "const": "recovery.approved"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "incident_id",
            "recovery_action_id",
            "approved_by",
            "approved_at",
            "action_type",
            "idempotency_key",
            "approval_record_version"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "incident_id": {
              "type": "string",
              "format": "uuid"
            },
            "recovery_action_id": {
              "type": "string",
              "format": "uuid"
            },
            "approved_by": {
              "type": "string",
              "format": "uuid"
            },
            "approved_at": {
              "type": "string",
              "format": "date-time"
            },
            "action_type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "idempotency_key": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "approval_record_version": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "recovery.completed": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://schemas.roottracer.dev/events/v1/recovery.completed.schema.json",
      "title": "RootTracer recovery.completed v1",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "message_id",
        "message_type",
        "schema_version",
        "created_at",
        "correlation_id",
        "attempt",
        "payload"
      ],
      "properties": {
        "message_id": {
          "type": "string",
          "format": "uuid"
        },
        "message_type": {
          "type": "string",
          "const": "recovery.completed"
        },
        "schema_version": {
          "type": "integer",
          "const": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "correlation_id": {
          "type": "string",
          "format": "uuid"
        },
        "attempt": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "project_id",
            "incident_id",
            "recovery_action_id",
            "execution_id",
            "status",
            "executed_at",
            "verified_at",
            "verification",
            "failure_code"
          ],
          "properties": {
            "project_id": {
              "type": "string",
              "format": "uuid"
            },
            "incident_id": {
              "type": "string",
              "format": "uuid"
            },
            "recovery_action_id": {
              "type": "string",
              "format": "uuid"
            },
            "execution_id": {
              "type": "string",
              "format": "uuid"
            },
            "status": {
              "type": "string",
              "enum": [
                "SUCCEEDED",
                "FAILED"
              ]
            },
            "executed_at": {
              "type": "string",
              "format": "date-time"
            },
            "verified_at": {
              "type": "string",
              "format": "date-time"
            },
            "verification": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "outcome",
                "check_id",
                "summary"
              ],
              "properties": {
                "outcome": {
                  "type": "string",
                  "enum": [
                    "HEALTHY",
                    "UNHEALTHY",
                    "INCONCLUSIVE"
                  ]
                },
                "check_id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "summary": {
                  "type": "string",
                  "maxLength": 1024
                }
              }
            },
            "failure_code": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 80
            }
          }
        }
      }
    }
  }
}
